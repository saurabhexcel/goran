function formatISODateToDDMMYYYY(isoDate) {
  const date = new Date(isoDate);
  const day = String(date.getDate()).padStart(2, "0");
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const year = date.getFullYear();
  return `${day}.${month}.${year}`;
}

function getTodayDate(value) {
  const today = new Date();
  const day = String(today.getDate()).padStart(2, "0");
  const month = String(today.getMonth() + 1).padStart(2, "0");
  const year = today.getFullYear();
  return `${day}.${month}.${year}`;
}

function getTomorrowDate() {
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const day = String(tomorrow.getDate()).padStart(2, "0");
  const month = String(tomorrow.getMonth() + 1).padStart(2, "0");
  const year = tomorrow.getFullYear();
  return `${day}.${month}.${year}`;
}


function filterTasks(dateToFilter, value) {
  console.log("calling filter task=============")
  const localData = localStorage.getItem("allListAndTask");

  if (!localData) {
    console.error("No data found in localStorage with key 'allListAndTask'");
    return;
  }

  const parsedData = JSON.parse(localData);
  const filteredData = [];

  parsedData.data.forEach((list) => {
    const { taskList, tasks } = list;
    const matchingTasks = [];
    tasks.forEach((task) => {
      if (task.due) {
        const dueDateFormatted = formatISODateToDDMMYYYY(task.due);

        if (dueDateFormatted === dateToFilter) {
          const sublistMatch = task.title.match(/s-([^\s#]+)/);
          const sectionMatch = task.title.match(/#(\S+)/);
          let taskName = task.title;
          taskName = taskName.replace(/s-[^\s#]+/, "").replace(/#\S+/, "").trim();

          matchingTasks.push({
            taskName,
            sublist: sublistMatch ? sublistMatch[1] : "",
            section: sectionMatch ? sectionMatch[1] : "",
            dueDate: dueDateFormatted,
            taskId: task.id,
            listId: taskList.id,
          });
        }
      }
    });

    if (matchingTasks.length > 0) {
      filteredData.push({
        listName: taskList.title,
        listId: taskList.id,
        tasks: matchingTasks,
      });
    }
  });

  renderTasks(filteredData, value);
}


