     <!-- Form Container (Initially Hidden) -->
      <div id="formContainer" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center">
        <div class="bg-gray-100 p-6 rounded-lg shadow-lg w-full max-w-2xl">
          <!-- Header with Close Button -->
          <div class="flex justify-between items-center mb-4">
            <input type="text" placeholder="Add Title" class="text-xl w-full px-3 py-2 border rounded-md" />
            <button onclick="closeForm()" class="text-gray-400 hover:text-gray-600 text-3xl" id="closeButton">
              &times;
            </button>
          </div>

          <!-- Horizontal Divider -->
          <hr class="mb-4">

          <!-- Form -->
          <form id="addForm">
            <!-- List, Sublist, Section -->
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div>
                <label for="list" class="block text-sm font-medium text-gray-700 mb-1">List</label>
                <select id="list" class="w-full px-3 py-2 border rounded-md" onchange="getListId(this)">
                  <option >Choose List</option>
                </select>
              
              </div>

              <div>
                <label for="sublist" class="block text-sm font-medium text-gray-700 mb-1">Sublist</label>
                <select id="sublist" class="w-full px-3 py-2 border rounded-md" onchange="selectedSublist(this)">
                  <option id="selectedsublist">Choose Sublist</option>
                </select>
              </div>

              <div>
                <label for="section" class="block text-sm font-medium text-gray-700 mb-1">Section</label>
                <select id="section" class="w-full px-3 py-2 border rounded-md">
                  <option id="selectedsection">Choose Section</option>
                </select>
              </div>
            </div>

            <!-- Due Date and Description -->
            <div class="grid grid-cols-1 gap-4 mb-4">
              <div>
                <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
                <input type="date" id="dueDate" class="w-full px-3 py-2 border rounded-md">
              </div>

              <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea id="description" rows="3" class="w-full px-3 py-2 border rounded-md
                " placeholder="add description"></textarea>
              </div>
            </div>

            <!-- Save Button -->
            <div class="flex justify-end">
              <button type="button" class="px-6 py-2 bg-gray-300 rounded-md hover:bg-gray-400" id="saveButton" data-action="add">Save</button>
            </div>
            
          </form>
        </div>
      </div>

        <!-- Dropdown Menu -->
        <div
          id="dropdown"
          class="absolute top-20 left-[312px] mt-2 w-48 bg-white shadow-md rounded-lg hidden">
