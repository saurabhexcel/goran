            Sublists
          </p>
          <p
            class="dropdown-item px-4 py-2 text-sm hover:bg-gray-100 cursor-pointer flex justify-between items-center"
            onclick="selectSubListItem(this)">
            Due date
          </p>
        </div>
     
    <script>

      function toggleSublist(listId) {
          const sublist = document.getElementById(`sublist-${listId}`);
          const icon = document.getElementById(`icon-${listId}`);
          if (sublist.classList.contains('hidden')) {
            sublist.classList.remove('hidden');
            icon.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" w-20 h-20></path>
            `;
          } else {
            sublist.classList.add('hidden');
            icon.innerHTML = `
              <polyline points="9 18 15 12 9 6"></polyline>
            `;
          }
        }
        
      let Listsections;
      let listTitle;
      let baseID;
      let sections;
      let sublistTitle;
      let baselistId;
