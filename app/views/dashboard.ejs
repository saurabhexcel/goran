function configureSaveButton(actionType, taskId = null) {
  const saveButton = document.getElementById("saveButton");
  saveButton.setAttribute("data-action", actionType);
  if (taskId) {
    saveButton.setAttribute("data-task-id", taskId);
  } else {
    saveButton.removeAttribute("data-task-id");
  }
}
let listId;
document.getElementById("saveButton").addEventListener("click", function (e) {
  e.preventDefault();

  let actionType = this.getAttribute("data-action"); // Add or Update
  const taskTitle = document.querySelector("input[placeholder='Add Title']").value.trim();
  const listElement = document.getElementById("list");
  const sublistElement = document.getElementById("sublist");
  const sectionElement = document.getElementById("section");
  const dueDateElement = document.getElementById("dueDate");
  const descriptionElement = document.getElementById("description");
  listId = listElement.value;
  const sublistName = sublistElement.options[sublistElement.selectedIndex].text.trim();
  const sectionName = sectionElement.options[sectionElement.selectedIndex].text.trim();

  let formattedTitle;

  if (taskTitle) {
    if (sublistName !== "Choose Sublist" && sectionName !== "Choose Section") {
      formattedTitle = `${taskTitle} s-${sublistName}#${sectionName}`;
    } else if (sublistName !== "Choose Sublist") {
      formattedTitle = `${taskTitle} s-${sublistName}`;
    } else if (sectionName !== "Choose Section") {
      formattedTitle = `${taskTitle} #${sectionName}`;
    } else {
      formattedTitle = taskTitle;
    }
  }

  const dueDate = dueDateElement.value ? new Date(dueDateElement.value).toISOString() : null;
  const description = descriptionElement.value.trim();

  const payload = {
    title: formattedTitle,
    notes: description || null,
    due: dueDate || null,
  };

  let endpoint;
  let method;

  if (actionType === "add") {
    endpoint = `/tasks/addTask/${listId}`;
    method = "POST";
  } else if (actionType === "update") {
    const taskId = this.getAttribute("data-task-id");
    endpoint = `/tasks/googleTask/${listId}/${taskId}`;
    method = "PATCH";
  }

  fetch(endpoint, {
    method: method,
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify(payload),
  })
    .then((response) => response.json())
    .then((data) => {
      closeForm();
      const getLocalValue = localStorage.getItem('todayTask')
      callAllListAndTask(getLocalValue);
    })

    .catch((error) => {
      console.error("Error:", error);
    });
});


