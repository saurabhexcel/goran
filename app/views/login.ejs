<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TODO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body class="bg-gray-100 h-screen flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden max-w-sm w-full">
        <br />
        <br />
        <!-- Login Section -->
        <div class="py-6 p-12">
            <h1 class="text-3xl font-bold mb-8">Log in
            </h1>
            <form action="/login" method="post">
                <div class="mb-6">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">User Name</label>
                    <input type="text" id="email" name="email" placeholder="Username"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md">
                </div>
                <!-- <div class="mb-6">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Pasword</label>
                    <input type="password" id="password" name="password" placeholder="Your password"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md">
                </div> -->
                <button class="w-full bg-blue-400 text-white py-2 rounded-md mb-4">Login</button>
                <% if (errorMsg) { %>
                    <p class="text-red-500 text-xs italic mt-4">
                        <%= errorMsg %>
                    </p>
                    <% } %>
            </form>

            <h1 class="text-1xl font-bold mb-4">Or use an external provider</h1>
            <button id="googleLoginButton" class="w-full bg-blue-400 text-white py-2 rounded-md mb-4">
                Login with Google
            </button>
              
            <!-- <button class="w-full bg-blue-400 text-white py-2 rounded-md mb-4"><a id="loginButton">Login with Google</a></button> -->
            <!-- <a href="/register">Register</a> -->
        </div>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", () => {
    const getJWT = () =>
    document.cookie.split("; ").find((row) => row.startsWith("jwt="))?.split("=")[1] || null;
    console.log(getJWT,"getjwt toekn============")
    const getTokenExpiry = (token) => {
    console.log(token,"expired not=============")
    try {
      const payload = JSON.parse(atob(token.split(".")[1]));
      console.log(payload,"payload==============")
      return payload.exp;
    } catch {
      console.error("Invalid JWT token");
      return null;
    }
  };

  const refreshToken = async (email) => {
  console.log(email, "email==============");
  try {
    const response = await fetch("/access_token", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ email }),
    });

    if (response.ok) {
      console.log("Token  successfully refresed.");
      return true;
    } else {
      console.error("Failed to refresh token");
      return false;
    }
  } catch (error) {
    console.error("Error refreshing token:", error);
    return false;
  }
};

  const mainLoginCheck = async () => {
    const token = getJWT();
    if (!token) {
      return (window.location.href = "/auth_google");
    }

    const expiry = getTokenExpiry(token);
    const currentTime = Math.floor(Date.now() / 1000);
    if (expiry && expiry - currentTime < 10) {
      console.log("Token is about to expire, refreshing...");
      const payload = JSON.parse(atob(token.split(".")[1]));
      const isRefreshed = await refreshToken(payload.email);
      if (!isRefreshed) return alert("Unable to refresh token. Please log in again.");
    }
    window.location.href = "/auth_google";
  };

  const loginButton = document.querySelector("#googleLoginButton");
  if (loginButton) {
    loginButton.addEventListener("click", (event) => {
      event.preventDefault();
      mainLoginCheck();
    });
  }
});

    </script>
</body>

</html>